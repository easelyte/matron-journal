{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Canonical source: son-of-anton/docs/contracts/work-view.schema.json. Vendored consumer copies must not be edited directly.",
  "title": "WorkViewEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "group_by",
    "groups"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "ok",
        "empty",
        "error"
      ]
    },
    "group_by": {
      "enum": [
        "repo",
        "domain"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/group"
      }
    },
    "error": {
      "$ref": "#/definitions/error"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "empty"
          }
        }
      },
      "then": {
        "properties": {
          "groups": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "groups": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "definitions": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "loops"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "loops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/loop"
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "repo",
        "domain",
        "priority",
        "description",
        "status",
        "claim"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "description": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "blocked",
            "parked",
            "paused"
          ]
        },
        "claim": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/claim"
            }
          ]
        },
        "opened": {
          "description": "Optional. When the loop was filed (RFC 3339). Absent from producers that predate it or when the stored value is not a timestamp.",
          "type": "string",
          "format": "date-time"
        },
        "next_action": {
          "description": "Optional. One-line summary of the loop's next step.",
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "description": "Optional. Who owns the loop's next step (for example operator or claude).",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "convo_id",
        "holder_label",
        "claimed_at",
        "liveness"
      ],
      "properties": {
        "convo_id": {
          "type": "string"
        },
        "holder_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "claimed_at": {
          "type": "string",
          "format": "date-time"
        },
        "liveness": {
          "enum": [
            "live",
            "stale",
            "unknown"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "store_missing",
            "store_corrupt",
            "builder_failed",
            "builder_timeout"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
