{
  "name": "snapshot: conversations carry title/session_state/unread_count/snippet, ordered by last message time desc",
  "description": "Two conversations, one advanced by an agent (bumps unread + snippet), one advanced by the user's own send (does not bump unread). GET /snapshot's seq is the user's journal head; conversations are ordered by last message time (COALESCE(last_ts, created_at) DESC, id DESC), so the most recently messaged conversation is first.",
  "seed": {
    "users": [{ "as": "alice", "name": "alice", "password": "fixture-pw-2" }],
    "conversations": [
      { "id": "c1", "owner": "alice", "title": "Fix login bug", "sessionState": "running" },
      { "id": "c2", "owner": "alice", "title": "Notes", "sessionState": "done" }
    ],
    "events": [
      { "convo": "c1", "sender": "agent:box-2", "type": "text", "payload": { "body": "starting work" } },
      { "convo": "c2", "sender": "user:alice", "type": "text", "payload": { "body": "a note to self" } }
    ]
  },
  "steps": [
    { "kind": "http", "method": "POST", "path": "/login",
      "body": { "username": "alice", "password": "fixture-pw-2", "device_name": "mac" },
      "expect": { "status": 200, "body": {
        "token": { "$bind": "alice_token" }, "device_id": { "$type": "integer" }, "user_id": { "$ref": "alice.user_id" }
      } } },
    { "kind": "http", "method": "GET", "path": "/snapshot", "token": { "$ref": "alice_token" },
      "expect": { "status": 200, "body": { "coordinator_convo_id": null, "pins": [],
        "seq": 2,
        "agents": [],
        "conversations": [
          {
            "id": "c2", "title": "Notes", "auto_title": "Notes", "session_state": "done", "session_outcome": null,
            "last_seq": 2, "unread_count": 0, "snippet": "a note to self",
            "parent_convo_id": null, "summary": "", "summary_updated_at": 0, "repo": null, "agent_device_id": null, "agent_kind": null, "mission_id": null, "mission_count": 0,
            "created_at": { "$type": "integer" }, "last_ts": { "$type": "integer" }
          },
          {
            "id": "c1", "title": "Fix login bug", "auto_title": "Fix login bug", "session_state": "running", "session_outcome": null,
            "last_seq": 1, "unread_count": 1, "snippet": "starting work",
            "parent_convo_id": null, "summary": "", "summary_updated_at": 0, "repo": null, "agent_device_id": null, "agent_kind": null, "mission_id": null, "mission_count": 0,
            "created_at": { "$type": "integer" }, "last_ts": { "$type": "integer" }
          }
        ]
      } } }
  ]
}
