{
  "name": "ws hello: a client may lower the replay ceiling",
  "description": "A two-event backlog is below the server ceiling but above hello.max_replay. The server sends hello_ok, then snapshot_required and close 4009 without replaying events.",
  "server": { "maxReplay": 100 },
  "seed": {
    "users": [{ "as": "alice", "name": "alice", "password": "fixture-pw" }],
    "conversations": [{ "id": "c1", "owner": "alice" }],
    "events": [
      { "convo": "c1", "sender": "agent:a", "type": "text", "payload": { "body": "first" } },
      { "convo": "c1", "sender": "agent:a", "type": "text", "payload": { "body": "second" } }
    ]
  },
  "steps": [
    { "kind": "http", "method": "POST", "path": "/login",
      "body": { "username": "alice", "password": "fixture-pw", "device_name": "test" },
      "expect": { "status": 200, "body": {
        "token": { "$bind": "token" }, "device_id": { "$type": "integer" }, "user_id": { "$ref": "alice.user_id" }
      } } },
    { "kind": "ws_open", "conn": "client" },
    { "kind": "ws_send", "conn": "client", "frame": { "op": "hello", "token": { "$ref": "token" }, "cursor": 0, "max_replay": 1 } },
    { "kind": "ws_expect", "conn": "client", "frame": { "kind": "control", "op": "hello_ok", "coordinator_convo_id": null, "settings": { "notices": true, "auto_approve_coordinator_spawns": false, "auto_archive_days": 30 }, "pins": [], "seq": 2, "device_id": { "$type": "integer" }, "name": "test" } },
    { "kind": "ws_expect", "conn": "client", "frame": { "kind": "control", "op": "snapshot_required" } },
    { "kind": "ws_expect_close", "conn": "client", "code": 4009 }
  ]
}
