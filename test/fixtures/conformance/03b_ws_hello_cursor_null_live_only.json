{
  "name": "ws hello: cursor null means live-only, no replay of pre-existing events",
  "description": "A journal event exists before the client ever connects. hello with cursor:null skips replay entirely (unlike cursor:0, which would replay everything) — the client sees hello_ok and nothing else until a NEW event happens live.",
  "seed": {
    "users": [{ "as": "alice", "name": "alice", "password": "fixture-pw-3" }],
    "agents": [{ "as": "bridge", "user": "alice", "name": "box-2" }],
    "conversations": [{ "id": "c1", "owner": "alice", "title": "session" }],
    "events": [
      { "convo": "c1", "sender": "agent:box-2", "type": "text", "payload": { "body": "before you connected" } }
    ]
  },
  "steps": [
    { "kind": "http", "method": "POST", "path": "/login",
      "body": { "username": "alice", "password": "fixture-pw-3", "device_name": "mac" },
      "expect": { "status": 200, "body": {
        "token": { "$bind": "alice_token" }, "device_id": { "$type": "integer" }, "user_id": { "$ref": "alice.user_id" }
      } } },

    { "kind": "ws_open", "conn": "client" },
    { "kind": "ws_send", "conn": "client", "frame": { "op": "hello", "token": { "$ref": "alice_token" }, "cursor": null } },
    { "kind": "ws_expect", "conn": "client", "frame": { "kind": "control", "op": "hello_ok", "coordinator_convo_id": null, "settings": { "notices": true, "auto_approve_coordinator_spawns": false, "auto_archive_days": 30 }, "pins": [], "seq": 1, "device_id": { "$type": "integer" }, "name": "mac" } },
    { "kind": "ws_expect_none", "conn": "client", "ms": 150 },

    { "kind": "ws_open", "conn": "agent" },
    { "kind": "ws_send", "conn": "agent", "frame": { "op": "hello", "token": { "$ref": "bridge.token" }, "cursor": null } },
    { "kind": "ws_expect", "conn": "agent", "frame": { "kind": "control", "op": "hello_ok", "settings": { "notices": true, "auto_approve_coordinator_spawns": false, "auto_archive_days": 30 }, "box_defaults": { "default_agent": null, "default_model": null, "default_effort": null }, "coordinator_convo_id": null, "seq": 1, "device_id": { "$type": "integer" }, "name": "box-2" } },
    { "kind": "ws_send", "conn": "agent", "frame": { "op": "publish", "convo_id": "c1", "type": "text", "payload": { "body": "live now" } } },

    { "kind": "ws_expect", "conn": "client", "frame": {
      "kind": "journal", "seq": 2, "convo_id": "c1", "ts": { "$type": "integer" },
      "sender": "agent:box-2", "sender_device_id": { "$ref": "bridge.device_id" }, "type": "text", "payload": { "body": "live now" }
    } }
  ]
}
