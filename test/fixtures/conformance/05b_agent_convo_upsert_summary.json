{
  "name": "agent convo_upsert: a summary change rides convo_meta; an identical re-send is a no-op; summary_updated_at advances only on a real change",
  "description": "A summary change now sets the same meta-changed condition a title change does, so the pinned-summary surface refreshes live instead of only at /snapshot. Re-sending a byte-identical summary appends NOTHING (the seq of the next real change proves it consumed no seq), and a summary-omitting upsert leaves summary_updated_at exactly where it was ($ref of the bound stamp) while still restating the stored summary on the event — so the event can never disagree with /snapshot, which the closing snapshot step asserts against the same bound stamp.",
  "seed": {
    "users": [{ "as": "dan", "name": "dan", "password": "fixture-pw-5b" }],
    "agents": [{ "as": "bridge", "user": "dan", "name": "dev-2" }]
  },
  "steps": [
    { "kind": "http", "method": "POST", "path": "/login",
      "body": { "username": "dan", "password": "fixture-pw-5b", "device_name": "mac" },
      "expect": { "status": 200, "body": {
        "token": { "$bind": "dan_token" }, "device_id": { "$type": "integer" }, "user_id": { "$ref": "dan.user_id" }
      } } },
    { "kind": "ws_open", "conn": "agent" },
    { "kind": "ws_send", "conn": "agent", "frame": { "op": "hello", "token": { "$ref": "bridge.token" }, "cursor": null } },
    { "kind": "ws_expect", "conn": "agent", "frame": { "kind": "control", "op": "hello_ok", "seq": 0, "device_id": { "$type": "integer" }, "name": "dev-2" } },
    { "kind": "ws_open", "conn": "client" },
    { "kind": "ws_send", "conn": "client", "frame": { "op": "hello", "token": { "$ref": "dan_token" }, "cursor": 0 } },
    { "kind": "ws_expect", "conn": "client", "frame": { "kind": "control", "op": "hello_ok", "seq": 0, "device_id": { "$type": "integer" }, "name": "mac" } },

    { "kind": "ws_send", "conn": "agent", "frame": { "op": "convo_upsert", "convo_id": "sess-sum", "title": "first title", "summary": "• opened the repo" } },
    { "kind": "ws_expect", "conn": "client", "frame": {
      "kind": "journal", "seq": 1, "convo_id": "sess-sum", "ts": { "$type": "integer" },
      "sender": "agent:dev-2", "sender_device_id": { "$ref": "bridge.device_id" }, "type": "convo_meta",
      "payload": { "title": "first title", "parent_convo_id": null, "agent_device_id": { "$ref": "bridge.device_id" }, "agent_kind": null, "summary": "• opened the repo", "summary_updated_at": { "$bind": "stamp1" } }
    } },

    { "kind": "ws_send", "conn": "agent", "frame": { "op": "convo_upsert", "convo_id": "sess-sum", "summary": "• opened the repo" } },
    { "kind": "ws_expect_none", "conn": "client", "ms": 150 },

    { "kind": "ws_send", "conn": "agent", "frame": { "op": "convo_upsert", "convo_id": "sess-sum", "title": "renamed" } },
    { "kind": "ws_expect", "conn": "client", "frame": {
      "kind": "journal", "seq": 2, "convo_id": "sess-sum", "ts": { "$type": "integer" },
      "sender": "agent:dev-2", "sender_device_id": { "$ref": "bridge.device_id" }, "type": "convo_meta",
      "payload": { "title": "renamed", "parent_convo_id": null, "agent_device_id": { "$ref": "bridge.device_id" }, "agent_kind": null, "summary": "• opened the repo", "summary_updated_at": { "$ref": "stamp1" } }
    } },

    { "kind": "ws_send", "conn": "agent", "frame": { "op": "convo_upsert", "convo_id": "sess-sum", "summary": "• opened the repo\n• fixed the parser" } },
    { "kind": "ws_expect", "conn": "client", "frame": {
      "kind": "journal", "seq": 3, "convo_id": "sess-sum", "ts": { "$type": "integer" },
      "sender": "agent:dev-2", "sender_device_id": { "$ref": "bridge.device_id" }, "type": "convo_meta",
      "payload": { "title": "renamed", "parent_convo_id": null, "agent_device_id": { "$ref": "bridge.device_id" }, "agent_kind": null, "summary": "• opened the repo\n• fixed the parser", "summary_updated_at": { "$bind": "stamp2" } }
    } },

    { "kind": "http", "method": "GET", "path": "/snapshot", "token": { "$ref": "dan_token" },
      "expect": { "status": 200, "body": {
        "seq": 3,
        "agents": [{ "device_id": { "$ref": "bridge.device_id" }, "name": "dev-2", "tag_char": { "$ignore": true } }],
        "conversations": [
          {
            "id": "sess-sum", "title": "renamed", "session_state": "running", "session_outcome": null,
            "last_seq": 3, "unread_count": 0, "snippet": "",
            "parent_convo_id": null, "summary": "• opened the repo\n• fixed the parser", "summary_updated_at": { "$ref": "stamp2" },
            "agent_device_id": { "$ref": "bridge.device_id" }, "agent_kind": null,
            "created_at": { "$type": "integer" }, "last_ts": null
          }
        ]
      } } }
  ]
}
